{
  "name": "devincast",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "npm run build && wrangler dev",
    "next:dev": "next dev",
    "start": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "cf-typegen": "wrangler types"
  },
  "license": "MIT",
  "description": "DevinCast — live two-host sports commentary for an autonomous coding agent, on Cloudflare Agents + ElevenLabs.",
  "dependencies": {
    "agents": "^0.23.0",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9",
    "wrangler": "^4.134.0"
  }
}
